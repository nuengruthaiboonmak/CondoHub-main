{
  "name": "condohub",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed:bootstrap": "tsx --conditions=react-server scripts/seed-bootstrap.ts",
    "db:seed:e2e": "tsx --conditions=react-server scripts/seed-e2e.ts",
    "db:seed:reset": "tsx --conditions=react-server scripts/seed-reset.ts",
    "dev": "tsx --conditions=react-server src/server/index.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "start": "tsx --conditions=react-server src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:seed:scenario": "tsx --conditions=react-server scripts/seed-scenario.ts",
    "db:seed:e2e-admin": "tsx --conditions=react-server scripts/e2e-admin.ts",
    "billing:ops": "tsx --conditions=react-server scripts/billing-ops.ts",
    "docs:seed": "tsx --conditions=react-server scripts/docs-demo.ts",
    "docs:shots": "tsx --conditions=react-server scripts/docs-shots.ts",
    "maintenance:ops": "tsx --conditions=react-server scripts/maintenance-ops.ts",
    "chat:ops": "tsx --conditions=react-server scripts/chat-ops.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@hookform/resolvers": "^5.9.1",
    "better-auth": "1.7.7",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.57.0",
    "next": "^16.4.0",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}